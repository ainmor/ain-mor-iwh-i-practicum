doctype html
html
  head
    title= title
    link(rel="stylesheet" href="/css/style.css")
  body
    h1= title

    p
      a(href="/update-cobj") Add to this table

    table
      thead
        tr
          th Name
          th Author
          th Genre
      tbody
        each record in records
          tr
            td= record.properties.name
            td= record.properties.author
            td= record.properties.genre